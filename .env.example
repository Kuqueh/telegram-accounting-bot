# Telegram Bot token — get from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=your_botfather_token_here

# Google Gemini API key — get free at https://aistudio.google.com (click "Get API key")
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — get free at https://console.groq.com (used for voice-to-text)
GROQ_API_KEY=your_groq_api_key_here

# Google Sheet document ID — the long ID in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEETS_ID=your_google_sheet_document_id_here

# Google Service Account JSON — paste the ENTIRE contents of your downloaded JSON file on ONE line
# The JSON must contain all these fields (values will be your real credentials):
# {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
